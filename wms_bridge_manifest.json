{
  "manifest_version": 3,
  "name": "IntraCity · Kết nối WMS",
  "version": "3.4.1",
  "key": "",
  "description": "Kết nối tab WMS được chọn với IntraCity trên máy. Chỉ tải khi bấm trong app.",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://wms.ssc.shopee.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kết nối IntraCity"
  },
  "icons": {
    "128": "icon.png"
  }
}
